# omocop-swarm configuration
#
# Copy to .env. This file is read by `omocop-swarm auth` and by the CLI.
# The MCP server does NOT read it — see the note at the bottom, it is the most
# common setup mistake.

# --- Required for signing in ------------------------------------------------

# Client id from your app at https://foursquare.com/developers/apps
# There is no client secret: the flow used here is the implicit grant, which
# has none. Register the app's redirect URI as exactly:
#   http://localhost:3535/callback
FOURSQUARE_CLIENT_ID=your-client-id-here

# --- Optional ---------------------------------------------------------------

# A token supplied directly, instead of signing in. An environment variable
# always wins over the token `auth` stored. Never commit a real one.
# FOURSQUARE_TOKEN=

# Where the archive lives: raw JSONL, the SQLite index, sync state, the token.
# Defaults to ~/.omocop-swarm
# SWARM_DATA_DIR=

# Port for the sign-in server. The redirect URI is derived from it, so changing
# this means re-registering the redirect URI on the Foursquare app to match.
SWARM_AUTH_PORT=3535

# Hour a "day" starts at, 0-23. At 6, a 02:00 check-in counts towards the night
# before, which is usually what someone asking "where was I on Friday" means.
SWARM_DAY_START_HOUR=0

# Items per API request. 250 is the documented maximum.
# SWARM_PAGE_SIZE=250

# The pinned `v=YYYYMMDD` the API is asked to behave like. Pinned rather than
# computed from today, which would opt into every future breaking change on a
# day nobody was deploying. Changing it invalidates the cached capability probe;
# run `sync --reprobe` afterwards.
# SWARM_API_VERSION=20250401

# Hide the `sync` tool from the MCP tool list when no token is configured,
# rather than registering it so it can explain itself.
# SWARM_HIDE_UNAVAILABLE_TOOLS=false

# error | warn | info | debug — all logging goes to stderr, never stdout.
LOG_LEVEL=info

# --- Why this file is not enough --------------------------------------------
#
# An MCP server is launched by its client (Claude Code, Claude Desktop), not by
# a shell, so it inherits no environment and does not read .env.
#
# This is handled rather than worked around: `omocop-swarm auth` writes the
# token to token.json inside the archive directory, and the server reads it from
# there. Sign in once from a terminal and the MCP server is configured.
#
# The only thing an MCP client config may still need is SWARM_DATA_DIR, if the
# archive is not in the default location. See docs/setup.md.
